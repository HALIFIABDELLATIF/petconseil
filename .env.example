# --- Clé IA pour la génération automatique d'articles (au moins une requise pour le mode IA) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Modèles optionnels (valeurs par défaut dans le script)
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Tag Amazon Associates (obligatoire pour percevoir des commissions) ---
AMAZON_TAG=votretag-21

# --- Amazon Product Advertising API (choix automatique des vrais produits) ---
# Récupère ces clés dans ton espace Amazon Associates → "Product Advertising API"
PA_ACCESS_KEY=AKIAVOTRECLE
PA_SECRET_KEY=votre-secret
PA_TAG=votretag-21
